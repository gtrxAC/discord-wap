<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title>Settings</title>
</head>
<body>
    <div class="nav">
        <a href="/main">&lt; Home</a>
    </div>

    <form action="/main">
        <input type="hidden" name="t" value="<%= compressedToken %>">
        <input type="hidden" name="s5" value="0"/>

        <div class="sb">Appearance</div>

        <label for="s0">Message load count:</label> <br/>
        <input type="number" name="s0" id="s0" min="1" max="100" value="<%= settings.messageLoadCount %>"> <br/>

        <label for="s1">Sort channels by:</label> <br/>
        <select name="s1" id="s1">
            <option value="0" <%= (settings.channelListLayout == 'recent') ? '' : 'selected' %>>Position</option>
            <option value="1" <%= (settings.channelListLayout == 'recent') ? 'selected' : '' %>>Last message</option>
        </select> <br/>

        <label for="s6">Latest messages:</label> <br/>
        <select name="s6" id="s6">
            <option value="0" <%= settings.reverseChat ? '' : 'selected' %>>On top</option>
            <option value="1" <%= settings.reverseChat ? 'selected' : '' %>>On bottom</option>
        </select> <br/>

        <label for="s7">Theme:</label> <br/>
        <select name="s7" id="s7">
            <% themes.forEach((th, i) => { %>
                <option value="<%= i %>" <%= (theme.id == th.id) ? 'selected' : '' %>><%= th.name %></option>
            <% }) %>
        </select> <br/>

        <label for="s8">Character set:</label> <br/>
        <select name="s8" id="s8">
            <option value="0" <%= settings.useAnyAscii ? '' : 'selected' %>>Full</option>
            <option value="1" <%= settings.useAnyAscii ? 'selected' : '' %>>Reduced</option>
        </select> <br/>

        <div class="sb">Time format</div>
        <div class="s">
            Current time: <strong><%= timePreview %></strong>
        </div>

        <label for="s2">Time offset (h):</label> <br/>
        <input type="number" name="s2" id="s2" min="-20" max="20" value="<%= settings.timeOffsetHours %>"/> <br/>

        <label for="s3">Time offset (min):</label> <br/>
        <input type="number" name="s3" id="s3" min="-59" max="59" value="<%= settings.timeOffsetMinutes %>"/> <br/>

        <label for="s4">Time format:</label> <br/>
        <select name="s4" id="s4">
            <option value="0" <%= settings.use12hTime ? '' : 'selected' %>>24 hours</option>
            <option value="1" <%= settings.use12hTime ? 'selected' : '' %>>12 hours</option>
        </select> <br/>

        <input type="submit" value="Save"><br/>

        <small>To save your settings, press 'save', then add the page to your bookmarks again.</small>
    </form>
</body>
</html>
