<style>
    /* Basics */
    * {
        box-sizing: border-box;
        font-family: sans-serif;
        <% if (wordBreakMethod == 'css') { %>
            word-break: break-word;
        <% } %>
    }
    body {
        margin: 0;
        background-color: #000;
        color: #eee;
    }

    .nav {
        width: 100%;
        background-color: #282828;
        padding: 0.5em;
    }
    .nav img, .chatbar img, .chatbar input {
        width: 28px;
        height: 28px;
    }
    .chatbar td {
        padding: 0 0.3em 0 0.3em;
    }
    .title {
        width: 100%;
        font-weight: bold;
        text-align: center;
    }

    .chatbar {
        width: 100%;
        background-color: #282828;
        padding: 0.4em 0.2em;
    }
    .chatbar textarea {
        width: 100%;
    }

    .pagebtn {
        text-align: center;
        padding: 0.5em;
    }
    .pagebtn input {
        width: 70%;
        font-size: 1em;
        padding: 0.3em;
    }

    /* Align icons with text */
    img, input[type="image"] {
        vertical-align: bottom;
    }

    /* Recipient message */
    .reply {
        color: #aaa;
        font-size: 12px;
        margin: 0.3em 0 0 0;
    }
    .replyrow {
        overflow: hidden;
        line-height: 1.1;
        vertical-align: bottom;
    }
    .replyicon {
        text-align: right;
    }
    .reply {
        padding-top: 0.4em;
    }
    .replyrow img {
        vertical-align: middle;
    }

    .chname {
        width: 100%;
    }

    /* Last message timestamp in channel list */
    .chtime {
        color: #999;
        font-size: 16px;
        text-align: right;
    }

    .time {
        color: #999;
        font-size: 12px;
    }

    .replyrow {
        overflow: hidden;
        line-height: 1.1;
        vertical-align: bottom;
    }
    .replyicon {
        text-align: right;
    }
    .reply {
        padding-top: 0.4em;
    }

    .message td {
        vertical-align: top;
        padding: 0.2em 0.2em 0.2em 0;
    }
    .message.noauthor td {
        padding-top: 0;
    }
    .message p a {
        font-weight: inherit;
    }
    .hidelink {
        color: inherit;
        text-decoration: none;
    }

    .overlay {
        position: absolute;
    }

    a img {
        border: inherit;
    }

    .messages {
        margin: 0 0.3em;
    }

    .channel {
        font-size: 20px;
        margin: 0.5em;
    }
    .channelhash {
        font-size: 24px;
        font-weight: bold;
        margin: 0 0.2em;
    }
    .guild {
        font-size: 20px;
        margin: 0.6em;
    }
    table .channelhash {
        margin-left: 0;
    }

    .categorytitle {
        background-color: #444;
        font-weight: bold;
        padding: 0.2em;
        margin: 0.2em;
    }
    .category {
        margin-bottom: 1em;
    }

    .section {
        margin: 0.5em 0.5em 0.8em 0.5em;
    }
    .section input, .section select, .section textarea {
        width: 100%;
        padding: 0.4em;
        font-size: 1em;
        margin-bottom: 0.5em;
    }
    .section input[type="checkbox"] {
        width: auto;
    }

    .center {
        margin: 8em 0;
        text-align: center;
    }

    .mention {
        background-color: #f13;
        color: white;
        font-weight: bold;
        padding: 0 0.3em;
    }

    .inboxguild {
        color: #999;
        font-size: 14px;
    }

    /* For dark theme */
    a {
        color: #55f;
    }
    input, textarea, select {
        background-color: #333;
        color: #eee;
        border: solid 1px #555;
        border-radius: 4px;
    }
    input[type="image"] {
        background-color: transparent;
        border: none;
    }
</style>