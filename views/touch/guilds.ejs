<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title>Servers</title>
</head>
<body>
    <table class="nav" id="t">
        <tr>
            <td><a href="/main<%= tokenParam %>"><img src="/back.png" alt="Back"></a></td>
            <td class="title">Servers</td>
            <td style="min-width: 24px"></td>
        </tr>
    </table>
    
    <% guilds.forEach((g, i) => { %>
        <div class="guild">
            <a class="hidelink" href="/g/<%= g.id %><%= tokenParam %>">
                <%- fit(g.name) %>
            </a>
        </div>
    <% }) %>

    <div class="nav" style="text-align: right;">
        <a href="#t"><img src="/top.png" alt="Top"></a>
    </div>
</body>
</html>