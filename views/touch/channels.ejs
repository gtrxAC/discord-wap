<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title><%= gname %></title>
    <style>
        td {
            padding: 0;
        }
    </style>
</head>
<body>
    <table class="nav" id="t">
        <tr>
            <td><a href="/g<%= tokenParam %>"><img src="/back.png" alt="Back"></a></td>
            <td class="title"><%- fit(gname) %></td>
            <td style="min-width: 24px"></td>
        </tr>
    </table>

    <% if (settings.altChannelListLayout) { %>
        <div class="sb"><%- fit(gname) %></div>
        <div class="s">
            <table>
                <% channels.forEach(c => { %>
                    <tr>
                        <td><a href="/g/<%= gid %>/c/<%= c.id %><%= tokenParam %><%= settings.reverseChat ? '#b' : '' %>"><%- fit(c.name) %></a></td>
                        <td class="chtime"><%= c.timestamp %></td>
                    </tr>
                <% }) %>
            </table>
        </div>
    <% } else { %>
        <% channelCategories.forEach(cat => { %>
            <div class="categorytitle"><%- fit(cat.name) %></div>
            <div class="category">
                <% cat.children.forEach((c, i) => { %>
                    <div class="channel">
                        <a class="hidelink" href="/g/<%= gid %>/c/<%= c.id %><%= tokenParam %><%= settings.reverseChat ? '#b' : '' %>">
                            <span class="channelhash">#</span> <%- fit(c.name) %>
                        </a>
                    </div>
                <% }) %>
            </div>
        <% }) %>
    <% } %>

    <div class="nav" style="text-align: right;">
        <a href="#t"><img src="/top.png" alt="Top"></a>
    </div>
</body>
</html>