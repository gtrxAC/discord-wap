<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title><%= cname %></title>
</head>
<body>
    <div class="nav" id="t">
        <%- include("include/buttonBottom.ejs") %><br/>
        <a href="#">&lt; Channels</a><br/>
    </div>

    <!-- "View older messages" button -->
    <% if (messages.length == settings.messageLoadCount) { %>
        <form action="/ch<%= settings.reverseChat ? '#b' : '' %>" class="nav">
            <input type="hidden" name="id" value="<%= id %>">
            <input type="hidden" name="cname" value="<%= cname %>">
            <input type="hidden" name="before" value="<%= settings.reverseChat ? messages[0].id : messages[messages.length - 1].id %>"/>
            <input type="hidden" name="page" value="<%= Number(page) + 1 %>"/>
            <input type="submit" value="Older messages">
        </form>
    <% } %>

    <% messages.forEach((m, i) => { %>
        <!-- beginning of section for messages where the author is shown -->
        <% if (m.showAuthor) { %>
            <% if (i != 0) { %>
                </div> <!-- end section of previous message cluster-->
            <% } %>

            <div class="sb"><%- fit(m.author.name) %> <span class="time"><%= m.timestamp %></span></div>
            <div class="s">
        <% } %>

        <!-- preview of recipient message -->
        <% if (m.referenced_message) { %>
            <div>
                <img src="/wap/reply.gif" alt="reply to">
                <strong><%- fit(m.referenced_message.author.name) %></strong>
                <%- fit(m.referenced_message.content) %>
            </div>
        <% } %>
        
        <!-- content -->
        <% if (m.content) { %>
            <!-- <a class="msg" href="/reply?id=<%= id %>&cname=<%= encodeURIComponent(cname) %>&rec=<%= m.id %>&recname=<%= encodeURIComponent(m.author.name) %>"> -->
            <div>
                <%- fit(m.content) %>
            </div>
        <% } %>

        <!-- attachments (names/download links) -->
        <% if (m.attachments) { %>
            <% m.attachments.forEach(att => { %>
                <div>
                    <img src="/wap/page.png" alt="attachment">
                    <a href="<%= att.url %>"><%- fit(att.filename) %></a>
                </div>
            <% }) %>
        <% } %>
    <% }) %>

    <!-- "View newer messages" button -->
    <% if (page > 0) { %>
        <form action="/ch" class="nav">
            <input type="hidden" name="id" value="<%= id %>">
            <input type="hidden" name="cname" value="<%= cname %>">
            <% if (page > 1) { %>
                <input type="hidden" name="after" value="<%= settings.reverseChat ? messages[messages.length - 1].id : messages[0].id %>"/>
                <input type="hidden" name="page" value="<%= page - 1 %>"/>
            <% } %>
            <input type="submit" value="Newer messages" onclick="event.preventDefault(); window.history.back();">
        </form>
    <% } %>

    <form action="/send" method="post" id="b">
        <textarea name="text" id="text" maxlength="2000" placeholder="Message <%= cname %>"></textarea> <br/>
        <input type="hidden" name="id" value="<%= id %>"/>
        <input type="hidden" name="cname" value="<%= cname %>"/>
        <input type="hidden" name="fromchatbar" value="1"/>
        <input type="submit" value="Send">
    </form>

    <div class="nav">
        <a href="/send?id=<%= encodeURIComponent(id) %>&cname=<%= encodeURIComponent(cname) %>">Full</a><br/>
        <%- include("include/buttonTop.ejs") %>
    </div>
</body>
</html>