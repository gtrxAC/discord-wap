<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title><%= cname %></title>
</head>
<body>
    <div class="nav">
        <a href="/ch?cname=<%= encodeURIComponent(cname) %>&id=<%= id %><%= settings.reverseChat ? '#b' : '' %>">&lt; <%= cname %></a><br/>
    </div>

    <div class="sb">Your message</div>

    <form action="/send" method="post">
        <input type="hidden" name="id" value="<%= id %>"/>
        <input type="hidden" name="cname" value="<%= cname %>"/>
        <div><textarea name="text" id="text" rows="5" maxlength="2000"></textarea></div>
        <div><input type="submit" value="Send"></div>
    </form>
</body>
</html>
