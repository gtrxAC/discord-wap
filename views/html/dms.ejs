<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Direct msgs.</title>
    <!-- <link rel="stylesheet" href="/wap/<%= settings?.cssFile ?? 'style.css' %>"> -->
    <link rel="stylesheet" href="dw.css">
    <link rel="shortcut icon" href="/wap/icon.png" type="image/png">
</head>
<body>
    <table>
        <tr><th colspan="2">Direct messages</th></tr>
        <% dms.forEach(d => { %>
            <tr> 
                <td class="icon"><img src="/wap/page.png" alt="DM"></td>
                <td><a href="/wap/ch?<%= d.isGroup ? 'cname' : 'dn' %>=<%= encodeURIComponent(d.name) %>&id=<%= d.id %><%= settings.reverseChat ? '#bottom' : '' %>"><%- fit(d.name) %></a></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>