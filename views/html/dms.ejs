<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title>Direct msgs.</title>
</head>
<body>
    <div class="nav">
        <a href="/main">&lt; Home</a><br/>
    </div>
    <table>
        <tr><th colspan="2">Direct messages</th></tr>
        <% dms.forEach(d => { %>
            <tr> 
                <td class="icon"><img src="/wap/page.png" alt="DM"></td>
                <td><a href="/ch?<%= d.isGroup ? 'cname' : 'dn' %>=<%= encodeURIComponent(d.name) %>&id=<%= d.id %><%= settings.reverseChat ? '#b' : '' %>"><%- fit(d.name) %></a></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>