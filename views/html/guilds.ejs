<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Servers</title>
    <!-- <link rel="stylesheet" href="/wap/<%= settings?.cssFile ?? 'style.css' %>"> -->
    <link rel="stylesheet" href="dw.css">
    <link rel="shortcut icon" href="/wap/icon.png" type="image/png">
</head>
<body>
    <div class="nav">
        <a href="/wap/main">&lt; Home</a><br/>
    </div>
    
    <table>
        <tr><th colspan="2">Servers</th></tr>
        <% guilds.forEach(g => { %>
            <tr> 
                <td class="icon"><img src="/wap/go.png" alt="server"></td>
                <td><a href="/wap/g?gname=<%= encodeURIComponent(g.name) %>&id=<%= g.id %>"><%- fit(g.name) %></a></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>