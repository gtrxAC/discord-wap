<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title>Servers</title>
</head>
<body>
    <div class="nav">
        <a href="/main">&lt; Home</a><br/>
    </div>
    
    <div class="sb">Servers</div>
    <div class="s">
        <% guilds.forEach(g => { %>
            <div>
                <img src="/wap/go.png" alt="server">
                <a href="/g?gname=<%= encodeURIComponent(g.name) %>&id=<%= g.id %>"><%- fit(g.name) %></a>
            </div>
        <% }) %>
    </div>
</body>
</html>