<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("include/head.ejs") %>
    <title>Servers</title>
</head>
<body>
    <div class="nav">
        <a href="/main">&lt; Home</a><br/>
    </div>
    
    <table>
        <tr><th colspan="2">Servers</th></tr>
        <% guilds.forEach(g => { %>
            <tr> 
                <td class="icon"><img src="/wap/go.png" alt="server"></td>
                <td><a href="/g?gname=<%= encodeURIComponent(g.name) %>&id=<%= g.id %>"><%- fit(g.name) %></a></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>