<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card title="Servers">
        <p align="center">
            <anchor>
                <prev/>
                &lt; Back
                <% if (hasMoreAbove) { %>
                    <br/>
                    <anchor>
                        <go method="get" href="/g">
                            <postfield name="token" value="$(token)"/>
                            <postfield name="p" value="<%= previousPage %>"/>
                        </go>
                        &lt; Previous
                    </anchor>
                <% } %>
            </anchor>
        </p>
        <p>
            <% if (!guilds.length) { %>
                Nothing to see here...
            <% } %>

            <% guilds.forEach(g => { %>
                <anchor>
                    <go method="get" href="/g/<%= g.id %>">
                        <postfield name="token" value="$(token)"/>
                    </go>
                    <%- oneLine(g.name) %>
                </anchor>
                <br/>
            <% }) %>
        </p>
        <% if (hasMoreBelow) { %>
            <p align="center">
                <anchor>
                    <go method="get" href="/g">
                        <postfield name="token" value="$(token)"/>
                        <postfield name="p" value="<%= nextPage %>"/>
                    </go>
                    &gt; Next
                </anchor>
            </p>
        <% } %>
    </card>
</wml>