<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card id="main" title="<%- sanitize(gname) %>">
        <p align="center">
            <anchor>
                <prev/>
                &lt; Back
            </anchor>
        </p>
        <p>
            <% if (!channels.length) { %>
                Nothing to see here...
            <% } %>

            <% useCollapsedView = (settings.channelListLayout == 'collapsed' && channelCategories.length >= 2) %>

            <% if (useCollapsedView) { %>
                <% channelCategories.forEach((cat, i) => { %>
                    <a href="#c<%= i %>"><%- oneLine(cat.name) %></a>
                    <br/>
                <% }) %>
            <% } else { %>
                <% channels.forEach(c => { %>
                    <anchor>
                        <go method="get" href="/g/<%= gid %>/c/<%= c.id %>">
                            <postfield name="token" value="$(token)"/>
                        </go>
                        <%- oneLine(c.label) %>
                    </anchor>
                    <br/>
                <% }) %>
            <% } %>
        </p>
    </card>

    <% if (useCollapsedView) { %>
        <% channelCategories.forEach((cat, i) => { %>
            <card id="c<%= i %>" title="<%- sanitize(cat.name) %>">
                <p align="center">
                    <a href="#main">&lt; Back</a>
                </p>

                <% cat.channels.forEach(c => { %>
                    <anchor>
                        <go method="get" href="/g/<%= gid %>/c/<%= c.id %>">
                            <postfield name="token" value="$(token)"/>
                        </go>
                        <%- oneLine(c.label) %>
                    </anchor>
                    <br/>
                <% }) %>
            </card>
        <% }) %>
    <% } %>
</wml>