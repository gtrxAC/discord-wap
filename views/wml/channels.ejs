<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card title="<%- sanitize(gname) %>">
        <p align="center">
            <anchor>
                <prev/>
                &lt; Back
            </anchor>
        </p>
        <p>
            <% if (!channels.length) { %>
                Nothing to see here...
            <% } %>

            <% channels.forEach(c => { %>
                <anchor>
                    <go method="get" href="/g/<%= gid %>/c/<%= c.id %>">
                        <postfield name="token" value="$(token)"/>
                    </go>
                    <%- oneLine(c.label) %>
                </anchor>
                <br/>
            <% }) %>
        </p>
    </card>
</wml>