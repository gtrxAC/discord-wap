<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card id="share" title="$(cname)">
        <p align="center">
            <anchor>
                <prev/>
                Back
            </anchor>
        </p>

        <p>
            <b>Share:</b>
        </p>

        <p>
            <a href="<%= shareLinkUrl %>">Share link</a>
            <% if (rawContent) { %>
                <br/>
                <a href="<%= shareTextUrl %>">Share text</a>
            <% } %>
        </p>
    </card>
</wml>
