<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card id="main" title="Discord WAP">
        <onevent type="onenterforward">
            <refresh>
                <setvar name="token" value="<%= token %>"/>
            </refresh>
        </onevent>

        <p>
            <anchor>
                <go method="get" href="/g">
                    <postfield name="token" value="$(token)"/>
                </go>
                Servers
            </anchor>
            <br/>
            <a href="#dms">Direct messages</a>
            <br/>
            <anchor>
                <go method="get" href="/i">
                    <postfield name="token" value="$(token)"/>
                </go>
                Inbox
            </anchor>
            <br/>
            <anchor>
                <go method="get" href="/set">
                    <postfield name="token" value="$(token)"/>
                </go>
                Settings
            </anchor>
            <br/>
            <a href="/">Log out</a>
        </p>
    </card>

    <card id="dms" title="Direct msgs.">
        <p align="center">
            <anchor>
                <prev/>
                &lt; Back
            </anchor>
        </p>
        <p>
            <% if (!dms.length) { %>
                Nothing to see here...
            <% } %>

            <% dms.forEach(d => { %>
                <anchor>
                    <go method="get" href="/d/<%= d.id %>">
                        <postfield name="token" value="$(token)"/>
                    </go>
                    <%- oneLine(d.name) %>
                </anchor>
                <br/>
            <% }) %>
        </p>
    </card>
</wml>