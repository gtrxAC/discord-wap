<?xml version="1.0"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
    <card id="channel" title="<%- sanitize(cname) %>">
        <p align="center">
            <anchor>
                <prev/>
                &lt; Back
            </anchor>
            <br/>
            <anchor>
                <go href="#send">
                    <setvar name="message" value=""/>
                </go>
                Send message
            </anchor>
            <% if (page > 0) { %>
                <br/>
                <anchor>
                    <go method="get" href="<%= gpath %>/<%= id %>">
                        <postfield name="token" value="$(token)"/>
                        <% if (page > 1) { %>
                            <postfield name="p" value="<%= page - 1 %>"/>
                            <postfield name="a" value="<%= messages[0]?.id %>"/>
                        <% } %>
                    </go>
                    Newer messages
                </anchor>
            <% } %>
        </p>

        <% if (!messages.length) { %>
            <p>Nothing to see here...</p>
        <% } %>

        <% messages.forEach(m => { %>
            <p>
                <anchor>
                    <go href="#reply">
                        <setvar name="message" value=""/>
                        <setvar name="rec" value="<%= m.id %>"/>
                        <setvar name="recname" value="<%= m.author.name %>"/>
                    </go>
                    <%- oneLine(m.authorLine) %>
                </anchor>
            </p>
            <p>
                <%- m.referenced_message ? (`to ${oneLine(m.referenced_message.author.name, 4)}:<br/>`) : '' %>
                <%- sanitize(m.content) %>
            </p>
        <% }) %>

        <% if (messages.length == settings.messageLoadCount) { %>
            <p align="center">
                <anchor>
                    <go method="get" href="<%= gpath %>/<%= id %>">
                        <postfield name="token" value="$(token)"/>
                        <postfield name="p" value="<%= page + 1 %>"/>
                        <postfield name="b" value="<%= messages[messages.length - 1]?.id %>"/>
                    </go>
                    Older messages
                </anchor>
            </p>
        <% } %>
    </card>

    <card id="send" title="<%- sanitize(cname) %>">
        <onevent type="onenterbackward">
            <prev/>
        </onevent>

        <p>
            Your message:
            <br/>
            <input name="message" size="<%= textBoxSize %>"/>
        </p>
        <p align="center">
            <anchor>
                <go method="post" href="<%= gpath %>/<%= id %>/send">
                    <postfield name="token" value="$(token)"/>
                    <postfield name="text" value="$(message)"/>
                </go>
                &gt; Send
            </anchor>
            <br/>
            <anchor>
                <prev/>
                &lt; Back
            </anchor>
        </p>
    </card>

    <card id="reply" title="<%- sanitize(cname) %>">
        <onevent type="onenterbackward">
            <prev/>
        </onevent>

        <p>
            Reply to $(recname)
            <br/>
            <input name="message" size="<%= textBoxSize %>"/>
        </p>

        <p align="center">
            <anchor>
                <go method="post" href="<%= gpath %>/<%= id %>/send">
                    <postfield name="token" value="$(token)"/>
                    <postfield name="text" value="$(message)"/>
                    <postfield name="recipient" value="$(rec)"/>
                </go>
                &gt; Send @ON
            </anchor>
            <br/>
            <anchor>
                <go method="post" href="<%= gpath %>/<%= id %>/send">
                    <postfield name="token" value="$(token)"/>
                    <postfield name="text" value="$(message)"/>
                    <postfield name="recipient" value="$(rec)"/>
                    <postfield name="ping" value="0"/>
                </go>
                &gt; Send @OFF
            </anchor>
            <br/>
            <anchor>
                <prev/>
                &lt; Back
            </anchor>
        </p>
    </card>
</wml>